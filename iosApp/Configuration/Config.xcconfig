TEAM_ID=

PRODUCT_NAME=NuFitAI
PRODUCT_BUNDLE_IDENTIFIER=com.fghilmany.nufitai.NuFitAI$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// Shared.framework is a static Kotlin/Native framework; its cinterop dependency on the system
// SQLite library (via app.cash.sqldelight:native-driver) doesn't propagate to the app executable
// automatically, so it must be linked explicitly here too.
OTHER_LDFLAGS = $(inherited) -lsqlite3