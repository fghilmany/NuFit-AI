CREATE TABLE plan_day (
    id TEXT NOT NULL PRIMARY KEY,
    monthly_plan_id TEXT NOT NULL,
    day_number INTEGER NOT NULL,
    type TEXT NOT NULL,
    template_letter TEXT,
    -- Cardio-only blocks (WARM-01, main-session cardio, COOL-01) aren't always tied to a
    -- catalog exerciseId (e.g. "jalan di tempat" with no equipment) -- stored inline as JSON
    -- (ADR-003) rather than forced into planned_exercise, which stays exerciseId-only.
    warmup_umum TEXT,
    cardio TEXT,
    cooldown_penurunan_hr TEXT,
    FOREIGN KEY (monthly_plan_id) REFERENCES monthly_plan(id)
);

insertPlanDay:
INSERT INTO plan_day(
    id, monthly_plan_id, day_number, type, template_letter, warmup_umum, cardio, cooldown_penurunan_hr
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getPlanDaysForPlan:
SELECT * FROM plan_day WHERE monthly_plan_id = ? ORDER BY day_number ASC;

getPlanDayIdsFromDay:
SELECT id FROM plan_day WHERE monthly_plan_id = ? AND day_number >= ?;

deletePlanDaysFromDay:
DELETE FROM plan_day WHERE monthly_plan_id = ? AND day_number >= ?;
