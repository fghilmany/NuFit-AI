CREATE TABLE chat_message (
    id TEXT NOT NULL PRIMARY KEY,
    role TEXT NOT NULL,
    text TEXT NOT NULL,
    suggestion_exercise_id TEXT,
    suggestion_replaces_exercise_id TEXT,
    -- JSON array; non-empty only on the latest ASSISTANT message (techspec chat-ai.md §5).
    suggested_replies TEXT,
    status TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    -- techspec chat-ai.md §7 -- sync bookkeeping, mirrors monthly_plan's user_id/updated_at.
    user_id TEXT,
    updated_at INTEGER NOT NULL DEFAULT 0
);

upsertChatMessage:
INSERT OR REPLACE INTO chat_message(
    id, role, text, suggestion_exercise_id, suggestion_replaces_exercise_id, suggested_replies,
    status, created_at, user_id, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllMessages:
SELECT * FROM chat_message ORDER BY created_at ASC;

getSendingMessages:
SELECT * FROM chat_message WHERE status = 'SENDING';

selectChangedSince:
SELECT * FROM chat_message WHERE updated_at > ?;

selectById:
SELECT * FROM chat_message WHERE id = ?;

backfillUserId:
UPDATE chat_message SET user_id = ? WHERE user_id IS NULL;
