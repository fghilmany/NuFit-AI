CREATE TABLE full_assessment_result (
    id TEXT NOT NULL PRIMARY KEY,
    completed_at INTEGER NOT NULL,
    usia INTEGER,
    gender TEXT,
    par_q_answers TEXT NOT NULL,
    hard_stop_flagged INTEGER NOT NULL,
    hard_stop_acknowledged_at INTEGER,
    preferensi_alat TEXT NOT NULL,
    riwayat_cedera TEXT NOT NULL,
    capacity_test TEXT,
    goal TEXT NOT NULL,
    frekuensi_per_minggu INTEGER NOT NULL,
    hari_pilihan TEXT NOT NULL,
    durasi_sesi_menit INTEGER NOT NULL
);

insertFullAssessmentResult:
INSERT INTO full_assessment_result(
    id, completed_at, usia, gender, par_q_answers, hard_stop_flagged, hard_stop_acknowledged_at,
    preferensi_alat, riwayat_cedera, capacity_test, goal, frekuensi_per_minggu, hari_pilihan, durasi_sesi_menit
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getLatestFullAssessmentResult:
SELECT * FROM full_assessment_result ORDER BY completed_at DESC LIMIT 1;
