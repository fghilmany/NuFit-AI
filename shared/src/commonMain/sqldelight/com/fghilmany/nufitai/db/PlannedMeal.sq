CREATE TABLE planned_meal (
    id TEXT NOT NULL PRIMARY KEY,
    meal_plan_id TEXT NOT NULL,
    day_number INTEGER NOT NULL,
    slot TEXT NOT NULL,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    ingredients TEXT NOT NULL,   -- JSON array
    calories INTEGER NOT NULL,
    protein_g INTEGER NOT NULL,
    carb_g INTEGER NOT NULL,
    fat_g INTEGER NOT NULL,
    prep_minutes INTEGER NOT NULL,
    tag TEXT NOT NULL,
    FOREIGN KEY (meal_plan_id) REFERENCES meal_plan(id)
);

-- Not synced this pass (techspec meal-plan.md §6 scope note, mirrors WorkoutHistorySyncParticipant's
-- precedent of deferring nested-child sync).

insertPlannedMeal:
INSERT INTO planned_meal(
    id, meal_plan_id, day_number, slot, name, description, ingredients, calories, protein_g, carb_g, fat_g, prep_minutes, tag
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getPlannedMealsForPlan:
SELECT * FROM planned_meal WHERE meal_plan_id = ? ORDER BY day_number ASC, slot ASC;

-- AC-8: regenerate deletes+re-inserts a week's meals, mirrors PlanDay.sq's deletePlanDaysFromDay pattern.
deletePlannedMealsForPlan:
DELETE FROM planned_meal WHERE meal_plan_id = ?;

getPlannedMealById:
SELECT * FROM planned_meal WHERE id = ?;
