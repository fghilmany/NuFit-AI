CREATE TABLE workout_set_log (
    id TEXT NOT NULL PRIMARY KEY,
    workout_exercise_log_id TEXT NOT NULL,
    set_number INTEGER NOT NULL,
    weight_kg REAL NOT NULL,
    reps INTEGER NOT NULL,
    completed_at INTEGER NOT NULL,
    -- techspec chat-ai.md §7 -- sync bookkeeping, mirrors monthly_plan's user_id/updated_at.
    user_id TEXT,
    updated_at INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (workout_exercise_log_id) REFERENCES workout_exercise_log(id)
);

insertWorkoutSetLog:
INSERT INTO workout_set_log(
    id, workout_exercise_log_id, set_number, weight_kg, reps, completed_at, user_id, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getSetLogsForSession:
SELECT workout_set_log.* FROM workout_set_log
INNER JOIN workout_exercise_log ON workout_exercise_log.id = workout_set_log.workout_exercise_log_id
WHERE workout_exercise_log.workout_session_id = ?;

getSetLogsForExercise:
SELECT workout_set_log.* FROM workout_set_log
INNER JOIN workout_exercise_log ON workout_exercise_log.id = workout_set_log.workout_exercise_log_id
WHERE workout_exercise_log.exercise_id = ?;

selectChangedSince:
SELECT * FROM workout_set_log WHERE updated_at > ?;

selectById:
SELECT * FROM workout_set_log WHERE id = ?;

backfillUserId:
UPDATE workout_set_log SET user_id = ? WHERE user_id IS NULL;

upsertFromRemote:
INSERT OR REPLACE INTO workout_set_log(
    id, workout_exercise_log_id, set_number, weight_kg, reps, completed_at, user_id, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);
