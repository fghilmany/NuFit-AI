    <string name="onboarding_parq_top_bar_title">Health Check First</string>
    <string name="onboarding_parq_step_label">STEP 1 OF 1</string>
    <string name="onboarding_parq_answered_count">%1$d / %2$d Answered</string>
    <string name="onboarding_parq_intro_body">Before you start, let\'s make sure your training is safe. Answer the following questions honestly so we can tailor the right program for you.</string>
    <string name="onboarding_parq_safety_note">Your data is kept confidential and only used to optimize NuFit AI\'s training algorithm.</string>

    <string name="onboarding_parq_question_jantung_diagnosis">Has a doctor ever said you have a heart condition and recommended you only do physical activity as advised by a doctor?</string>
    <string name="onboarding_parq_question_nyeri_aktivitas">Do you ever feel chest pain during physical activity (brisk walking, climbing stairs, etc.)?</string>
    <string name="onboarding_parq_question_nyeri_istirahat">In the past month, have you felt chest pain while not being physically active (resting/sitting still)?</string>
    <string name="onboarding_parq_question_pusing_pingsan">Have you ever lost your balance due to dizziness, or fainted, for no clear reason?</string>
    <string name="onboarding_parq_question_tekanan_darah">Has a doctor ever told you that your blood pressure is high and not well controlled?</string>
    <string name="onboarding_parq_question_masalah_sendi">Do you have a bone or joint problem that could get worse if you change your physical activity pattern?</string>
    <string name="onboarding_parq_question_operasi_recent">Have you recently had bone, joint, or spine surgery in the past 12 months?</string>
    <string name="onboarding_parq_question_obat_rutin">Are you currently taking regular medication for blood pressure or your heart?</string>
    <string name="onboarding_parq_question_diabetes">Do you have diabetes, with blood sugar that has recently been unstable, going up and down?</string>
    <string name="onboarding_parq_question_kanker_aktif">Are you currently undergoing active treatment for cancer (chemotherapy/radiotherapy)?</string>
    <string name="onboarding_parq_question_kehamilan">Are you currently pregnant?</string>
    <string name="onboarding_parq_question_kondisi_lain">Is there any other health condition we should know about, not covered above?</string>

