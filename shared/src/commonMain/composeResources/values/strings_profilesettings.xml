    <string name="profilesettings_delete_confirm_title">Delete your account?</string>
    <string name="profilesettings_delete_confirm_body">Your account and all cloud data will be permanently deleted. Workout data stored on this device will NOT be deleted — your device will return to guest (local-only) mode.</string>
    <string name="profilesettings_delete_confirm_offline_notice">You need an internet connection to delete your account.</string>
    <string name="profilesettings_delete_confirm_action">Yes, Delete Account</string>

    <string name="profilesettings_disclaimer_top_bar_title">Medical Disclaimer</string>
    <string name="profilesettings_disclaimer_title">Before You Start</string>
    <string name="profilesettings_disclaimer_body">NuFit AI provides general workout guidance based on the information you provide. This app is NOT a substitute for medical advice, diagnosis, or treatment from a licensed doctor or certified personal trainer.\n\nIf you have any medical condition, are pregnant, take regular medication, or feel pain/dizziness during exercise, stop exercising and consult a medical professional before continuing.\n\nBy using this app, you understand that the risk of injury from exercising is entirely your own responsibility.</string>
    <string name="profilesettings_disclaimer_ack_label">I understand this disclaimer</string>

    <string name="profilesettings_privacy_top_bar_title">Privacy Policy</string>
    <string name="profilesettings_privacy_body">NuFit AI stores your workout and profile data locally on your device. If you sign in, this data is also stored on our servers for backup and cross-device sync.\n\nWe do not share your personal data with third parties without consent, except where required by law.\n\nYou can delete your account and cloud data at any time via the Delete Account menu.</string>

    <string name="profilesettings_about_top_bar_title">About the App</string>
    <string name="profilesettings_about_body">NuFit AI is a gym companion app that helps you get a workout program suited to your level and goals — from local templates to an AI-personalized plan.</string>
