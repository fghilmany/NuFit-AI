    <string name="profilesettings_delete_confirm_title">Hapus akun kamu?</string>
    <string name="profilesettings_delete_confirm_body">Akun dan seluruh data cloud kamu akan dihapus permanen. Data latihan yang tersimpan di HP ini TIDAK ikut terhapus — HP kamu akan kembali ke mode tamu (lokal saja).</string>
    <string name="profilesettings_delete_confirm_offline_notice">Kamu perlu koneksi internet untuk menghapus akun.</string>
    <string name="profilesettings_delete_confirm_action">Ya, Hapus Akun</string>

    <string name="profilesettings_disclaimer_top_bar_title">Disclaimer Medis</string>
    <string name="profilesettings_disclaimer_title">Sebelum Mulai</string>
    <string name="profilesettings_disclaimer_body">NuFit AI menyediakan panduan latihan umum berdasarkan informasi yang kamu berikan. Aplikasi ini BUKAN pengganti nasihat medis, diagnosis, atau perawatan dari dokter maupun personal trainer bersertifikat.\n\nJika kamu memiliki kondisi kesehatan tertentu, sedang hamil, mengonsumsi obat rutin, atau merasakan nyeri/pusing saat latihan, hentikan latihan dan konsultasikan ke tenaga medis profesional sebelum melanjutkan.\n\nDengan menggunakan aplikasi ini, kamu memahami bahwa risiko cedera saat berolahraga sepenuhnya menjadi tanggung jawab pribadi.</string>
    <string name="profilesettings_disclaimer_ack_label">Saya memahami disclaimer ini</string>

    <string name="profilesettings_privacy_top_bar_title">Kebijakan Privasi</string>
    <string name="profilesettings_privacy_body">NuFit AI menyimpan data latihan dan profil kamu secara lokal di perangkat. Jika kamu login, data ini juga disimpan di server kami untuk keperluan backup dan sinkronisasi antar-perangkat.\n\nKami tidak membagikan data pribadimu ke pihak ketiga tanpa izin, kecuali diwajibkan oleh hukum.\n\nKamu dapat menghapus akun dan data cloud kamu kapan saja melalui menu Hapus Akun.</string>

    <string name="profilesettings_about_top_bar_title">Tentang Aplikasi</string>
    <string name="profilesettings_about_body">NuFit AI adalah aplikasi pendamping latihan gym yang membantu kamu mendapatkan program latihan sesuai level dan tujuanmu — mulai dari template lokal hingga rencana yang dipersonalisasi AI.</string>
